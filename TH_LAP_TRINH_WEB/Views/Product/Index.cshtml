@using TH_LAP_TRINH_WEB.Models
@model Product

@{
    ViewData["Title"] = "Display";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />


<section class="section-product-detail">
    <div class="container">
        <div class="product-detail-grid">
            <!-- Product Images -->
            <div class="product-images">
                <div class="main-image">
                    <img src="@Model.Images.FirstOrDefault()?.Url" alt="Product Main Image" />
                </div>
                <div class="thumbnail-images">
                    @foreach (var image in Model.Images)
                    {
                        <img src="@image.Url" alt="Thumbnail Image" class="thumbnail" />
                    }
                </div>
            </div>

            <!-- Product Info -->
            <div class="product-info">
                <h1>@Model.Name</h1>
                <div class="price">@Model.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>

                <!-- Product Actions -->
                <div class="product-actions">
                    <div class="quantity">
                        <label>Số lượng:</label>
                        <div class="quantity-selector">
                            <button onclick="decreaseQuantity()">-</button>
                            <input type="number" value="1" min="1" />
                            <button onclick="increaseQuantity()">+</button>
                        </div>
                    </div>
                    <div class="buttons">
                        <button class="btn-add-cart" onclick="addToCart(@Model.Id)">Thêm vào giỏ hàng</button>
                        @* <button class="btn-buy-now" onclick="buyNow(@Model.Id)">Mua ngay</button> *@
                    </div>
                </div>

                <!-- Product Description -->
                <div class="product-description">
                    <h2>Mô tả sản phẩm</h2>
                    <div class="description-content">
                        <p>@Model.Description</p>
                    </div>
                </div>

                <!-- Product Specifications -->
                @* <div class="product-specs">
                    <h2>Thông số sản phẩm</h2>
                    <table>
                        <tr>
                            <td>Thương hiệu:</td>
                             <td>@Model.Brand</td> 
                        </tr>
                        <tr>
                            <td>Xuất xứ:</td>
                             <td>@Model.Origin</td> 
                        </tr>
                        <tr>
                            <td>Dung tích:</td>
                             <td>@Model.Volume</td> 
                        </tr>
                        <tr>
                            <td>Đối tượng:</td>
                             <td>@Model.Target</td> 
                        </tr>
                    </table>
                </div> *@
            </div>
        </div>
    </div>
</section>

<!-- Related Products -->

<section class="section-related-products">
    <div class="container">
        <h2>Sản phẩm liên quan</h2>
        <div class="related-products-grid">
            @foreach (var relatedProduct in ViewBag.RelatedProducts as IEnumerable<Product>)
            {
                <div class="item">
                    <a aria-label="link-product" href="@Url.Action("Index", "Product", new { id = relatedProduct.Id })">
                        <img src="@Model.Images?.FirstOrDefault()?.Url" alt="Product Main Image" />

                    </a>
                    <div class="detail">
                        <h3><a
                                href="@Url.Action("Index", "Product", new { id = relatedProduct.Id })">@relatedProduct.Name</a>
                        </h3>
                        <p>@relatedProduct.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


<script>

    document.querySelectorAll('.thumbnail').forEach(function (thumbnail) {
        thumbnail.addEventListener('click', function () {
            // Lấy ảnh thu nhỏ đã click
            var mainImage = document.querySelector('.main-image img');
            mainImage.src = this.src;
        });
    });

    function increaseQuantity() {
        var quantityInput = document.querySelector('.quantity-selector input');
        var currentQuantity = parseInt(quantityInput.value);
        quantityInput.value = currentQuantity + 1;
    }

    function decreaseQuantity() {
        var quantityInput = document.querySelector('.quantity-selector input');
        var currentQuantity = parseInt(quantityInput.value);
        if (currentQuantity > 1) {
            quantityInput.value = currentQuantity - 1;
        }
    }

    function addToCart(productId) {
        var quantityInput = document.querySelector('.quantity-selector input');
        var quantity = parseInt(quantityInput.value);

        // Check if quantity is valid
        if (isNaN(quantity) || quantity <= 0) {
            alert('Số lượng không hợp lệ.');
            return;
        }

        // Get the RequestVerificationToken from the hidden form input
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;


        fetch('/Home/AddToCart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token // Add token for CSRF protection
            },
            body: JSON.stringify({
                productId: productId,
                quantity: quantity
            })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Request failed');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                alert('Đã thêm sản phẩm vào giỏ hàng!');
                // updateCartSummary(data.cartTotal);  Update cart total on success
            } else {
                alert(data.message || 'Đã xảy ra lỗi. Vui lòng thử lại.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Đã xảy ra lỗi. Vui lòng thử lại.');
        });
    }

    
</script>

