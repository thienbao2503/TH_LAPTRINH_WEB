<div class="box-search">
    <h2>DS Đơn Hàng</h2>
    <div class="box-list-input">

        <input type="search" name="" placeholder="Nhập Tên tìm kiếm" id="">
        <button class="btn-search">
            <i class="fi fi-rr-search"></i>
        </button>
        <button class="btn-refresh">
            <i class="fi fi-rr-refresh"></i>
        </button>
    </div>
</div>
<div class="box-table">
    <table>
        <thead>
          

            <tr>
                <th>ID Đơn hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng giá trị đơn hàng</th>
                <th>Hàng động</th>
            </tr>


        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.OrderDate.ToString("g")</td>
                    <td>@order.TotalPrice.ToString("N0") đ</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary">Xem chi tiết</a>
                    </td>
                </tr>
            }


        </tbody>
    </table>
</div>