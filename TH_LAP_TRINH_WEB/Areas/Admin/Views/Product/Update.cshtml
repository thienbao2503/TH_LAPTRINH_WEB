@using TH_LAP_TRINH_WEB.Models
@model Product

@{
    ViewData["Title"] = "Update";
    Layout = "~/Areas/Admin/Views/_Layout.cshtml";
}

<div class="container-table">
    <h3>Cập Nhật</h3>

    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Update" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="control-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Input để tải ảnh mới -->
                <div class="form-group">
                    <label for="images">Upload Images (Max 5 images):</label>
                    <input type="file" name="images" id="images" class="form-control" accept="image/*" multiple />
                </div>

                <!-- Hiển thị ảnh mới được chọn -->
                <div class="form-group" id="newImagesSection" style="display: none;">
                    <label>New Images:</label>
                    <div id="previewImageContainer"></div> <!-- Chứa các ảnh được chọn -->
                </div>

                @if (Model.Images != null && Model.Images.Count > 0)
                {
                    <div class="form-group">
                        <label>Current Images:</label>
                        <ul>
                            @foreach (var image in Model.Images)
                            {
                                <li>
                                    <img src="@image.Url" alt="Product Image" style="max-width: 100px; height: auto; border: 1px solid #ccc; padding: 5px;" />
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="CategoryId" class="control-label"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Cập Nhật" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Về Danh Sách</a>
                </div>
            </form>
        </div>
    </div>

   
</div>

@section Scripts {
    <script>
        document.getElementById("images").addEventListener("change", function (event) {
            var previewContainer = document.getElementById("previewImageContainer");
            var newImagesSection = document.getElementById("newImagesSection");
            var currentImagesSection = document.getElementById("currentImagesSection");

            // Lấy danh sách các file ảnh đã chọn
            var files = event.target.files;
            if (files && files.length > 0) {
                // Ẩn nhóm ảnh cũ
                if (currentImagesSection) {
                    currentImagesSection.style.display = "none";
                }

                // Hiển thị nhóm ảnh mới được chọn
                if (newImagesSection) {
                    newImagesSection.style.display = "block";
                }

                // Xóa nội dung của preview cũ trước khi hiển thị ảnh mới
                previewContainer.innerHTML = "";

                // Hiển thị tất cả các ảnh mới được chọn
                Array.from(files).forEach(function(file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        var img = document.createElement("img");
                        img.src = e.target.result;
                        img.style.maxWidth = "100px";
                        img.style.height = "auto";
                        img.style.border = "1px solid #ccc";
                        img.style.padding = "5px";
                        previewContainer.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                // Nếu không có ảnh được chọn, hiển thị lại ảnh cũ
                if (currentImagesSection) {
                    currentImagesSection.style.display = "block";
                }
                previewContainer.innerHTML = "";  // Ẩn ảnh đã chọn
                if (newImagesSection) {
                    newImagesSection.style.display = "none";  // Ẩn nhóm ảnh mới nếu không có ảnh được chọn
                }
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

